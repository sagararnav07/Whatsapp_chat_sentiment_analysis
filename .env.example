# ══════════════════════════════════════════════════════════════════════════════
# ChatSense AI + Rasa Analyser — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# All variables are OPTIONAL — the app works without any of them.

# ── Groq API (ChatSense AI) ──────────────────────────────────────────────────
# Required for ChatSense AI reasoning. Get yours at https://console.groq.com/
GROQ_API_KEY=

# ── Rasa Analyser (OPTIONAL) ─────────────────────────────────────────────────
# Set to 'true' to enable Rasa NLP engine by default.
# Can also be toggled at runtime via the sidebar toggle.
USE_RASA=false

# URL where the Rasa server is running.
# Default: http://localhost:5005 (local Docker container)
RASA_URL=http://localhost:5005

# Rasa operation mode:
#   'nlu_only' — Rasa handles intent/entity extraction only,
#                retrieval + reasoning uses existing ChatSense pipeline.
#   'full'     — Rasa handles the complete conversation via webhook.
# Recommended: 'nlu_only' for best results with existing retrieval engine.
RASA_MODE=nlu_only

# Timeout in seconds for Rasa HTTP requests.
RASA_TIMEOUT=10

# Sender ID for Rasa conversations (tracks conversation state).
RASA_SENDER_ID=streamlit_user

# Data API URL — used by Rasa custom actions to fetch chat data.
# Points to the Streamlit app. When running in Docker, use:
#   http://host.docker.internal:8501
RASA_DATA_API_URL=http://host.docker.internal:8501
